# Gateway URL reachable by the Nuxt server (not by the browser)
NUXT_GATEWAY_BASE_URL=http://localhost:8080

# Adjust these paths to the routes exposed by the gateway repository.
NUXT_GATEWAY_LOGIN_PATH=/api/v1/auth/login
NUXT_GATEWAY_REGISTER_PATH=/api/v1/auth/register
NUXT_GATEWAY_ME_PATH=/api/v1/auth/me
